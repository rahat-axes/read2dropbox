# Example environment file. Copy to .env and fill in as needed.
# NEVER commit your real .env — it is gitignored.
#
# For normal use you do NOT need this file: `readbox auth` stores credentials in
# your per-user config directory. These vars only exist for local development /
# testing against the API before the auth flow is wired up (Phases 1–4).

# A Read AI access token obtained by hand (Phase 1). Expires ~10 minutes.
READBOX_READ_ACCESS_TOKEN=

# Dropbox app key from the Dropbox App Console (Phase 4). Not a secret.
READBOX_DROPBOX_APP_KEY=
